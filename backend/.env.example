# ── LLM Provider Configuration (none | ollama | gemini | groq | anthropic) ──
# Default: none (100% offline, zero tokens, zero cost, no keys required)
LLM_PROVIDER=none

# Ollama (Local on-device models, completely private & free)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini Free Tier (API key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq Cloud Free Tier (API key from Groq Console)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic (Optional paid cloud Claude provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Rate Limiter & Circuit Breaker
RATE_LIMIT_RPM=30
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# Database & Storage
DATABASE_URL=sqlite:///./data/finpilot.db
UPLOADS_DIR=./data/uploads
DEFAULT_CURRENCY=INR
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
USE_OCR=false
